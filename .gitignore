# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Generated runtime/offline data. Only the two immutable production stores
# required by the backend image are versioned; reports and raw downloads stay local.
python-service/data/*
!python-service/data/historical.sqlite.gz
!python-service/data/admin_boundaries.sqlite
!python-service/data/firms_country_archive/
python-service/data/firms_country_archive/*
!python-service/data/firms_country_archive/manifest.json
!python-service/data/firms_api_current/
python-service/data/firms_api_current/*
!python-service/data/firms_api_current/manifest.json
