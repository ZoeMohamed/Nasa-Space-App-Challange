# Keep the real key server-side. Request one at https://firms.modaps.eosdis.nasa.gov/api/area/
# Never commit a real key here: this file is public.
NASA_FIRMS_MAP_KEY=your_firms_map_key_here
FIRMS_API_BASE=https://firms.modaps.eosdis.nasa.gov/api/area/csv
# Python service created from the existing prototype-harmonized pipeline.
PYTHON_PROCESSING_API_URL=http://127.0.0.1:8000
# Shared officer passcode for /officer-login. Set the SAME value on the Python
# backend (it checks the X-Officer-Key header). Leave empty and nobody can sign
# in as officer (citizen reports stay locked). Use a long random string, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
OFFICER_ACCESS_KEY=
