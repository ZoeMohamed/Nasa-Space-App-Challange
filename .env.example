# Keep the real key server-side. Request one at https://firms.modaps.eosdis.nasa.gov/api/area/
# Never commit a real key here: this file is public.
NASA_FIRMS_MAP_KEY=your_firms_map_key_here
FIRMS_API_BASE=https://firms.modaps.eosdis.nasa.gov/api/area/csv
# Python service created from the existing prototype-harmonized pipeline.
PYTHON_PROCESSING_API_URL=http://127.0.0.1:8000
ENABLE_CITIZEN_REPORTS=false
ENABLE_PUBLIC_REPORT_REVIEW=false
NEXT_PUBLIC_CITIZEN_REPORTS_ENABLED=false
NEXT_PUBLIC_REPORT_REVIEW_ENABLED=false
# Supabase Postgres backs the public incident workflow.
# `supabase status -o env` prints the local API URL and publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_local_or_hosted_publishable_key
